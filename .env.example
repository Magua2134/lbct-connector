# ============================================
# EModal + LBCT Connector 环境变量模板
# 复制为 .env 后填入真实值
# ============================================

# ---- API Key 安全验证 (任意随机字符串，和 wrangler.toml 的 CONNECTOR_API_KEY 保持一致) ----
CONNECTOR_API_KEY=change-me-to-a-long-random-string

# ---- 2Captcha API Key (LBCT 登录打码用) ----
# 获取: https://2captcha.com/enterpage
# 充值: 最低 $3，按成功计费 ~$2.99/1000 次 reCAPTCHA v2
TWOCAPTCHA_API_KEY=

# ---- (可选) 住宅代理，避免 Render/Railway 数据中心 IP 被码头 WAF 拦截 ----
# 推荐服务商: Bright Data, Oxylabs, GeoSurf, NetNut
# 格式: http://user:password@host:port
# PROXY_URL=

# ---- (可选) 监听端口，默认 3000 ----
# PORT=3000
